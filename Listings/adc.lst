   59          // 获取ADC转换结果函数
   60          // 入口参数: ch (ADC通道选择)
   61          // 函数返回: ADC转换结果
   62          ////////////////////////////////////////
   63          uint16_t ADC_Convert(uint8_t ch)
   64          {
   65   1          uint16_t res;                       //定义保存ADC结果的变量
   66   1      
   67   1          ADC_ActiveChannel(ch);              //选择ADC通道
   68   1          ADC_Start();                        //开始ADC转换
   69   1          while (!fADCConverted);             //等待ADC转换完成
   70   1          fADCConverted = 0;                  //清除ADC转换结束标志
   71   1          res = ADC_ReadResult();             //读取ADC转换结果
   72   1      
   73   1          return res;                         //返回ADC结果
   74   1      }
