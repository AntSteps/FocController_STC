   29          // ADC初始化函数
   30          // 入口参数: 无
   31          // 函数返回: 无
   32          ////////////////////////////////////////
   33          void ADC_Init(void)
   34          {
   35   1          ADC_SetClockDivider(0);             //设置ADC时钟
   36   1          ADC_ResultRightAlign();             //设置ADC结果右对齐(12位结果)
   37   1          ADC_EnablePWMTrig();                //使能PWM同步触发ADC
   38   1          ADC_DisableRepeatConv();            //关闭ADC自动重复转换功能
   39   1      
   40   1          ADC_SetCSSetupCycles(0);            //设置ADC通道选择建立时间
   41   1          ADC_SetCSHoldCycles(1);             //设置ADC通道选择保持时间
   42   1          ADC_SetSampleDutyCycles(9);         //设置ADC通道采样时间
   43   1      
   44   1          ADC_DisableETR();                   //禁止ADC外部触发功能
   45   1      
   46   1          ADC_SetIntPriority(0);              //设置中断为最低优先级
   47   1          ADC_EnableInt();                    //使能ADC中断
   48   1          fADCConverted = 0;                  //初始化转换结束标志
   49   1      
   50   1          ADC_ActiveChannel(1);               //选择ADC通道
   51   1          ADC_Enable();                       //使能ADC功能
   52   1      
