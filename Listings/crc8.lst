   24          /**
   25           * @brief CRC8校验函数（双模式）
   26           * @param dat 数据包指针（纯数据 或 数据+CRC8）
   27           * @param size 数据包总长度：
   28           *             - 若为纯数据，size = 数据长度（返回CRC8值）
   29           *             - 若为数据+CRC8，size = 数据长度 + 1（返回0=正确，非0=错误）
   30           * @param has_crc 标记位：0=数据包不含CRC（仅计算），1=数据包含CRC（验证）
   31           * @return 见函数说明
   32           */
   33          uint8_t Mem_CRC8_Check(uint8_t *dat, int size, uint8_t has_crc)
   34          {
   35   1          uint8_t crc = 0x00;
   36   1          int i;
   37   1          int calc_size = size;
   38   1      
   39   1          if (has_crc)
   40   1          {
   41   2              if (size < 1)
   42   2                  return 0xFF;
   43   2              calc_size = size - 1;
   44   2          }
   45   1      
   46   1          for (i = 0; i < calc_size; i++)
   47   1          {
   48   2              crc = CRC8_TAB[crc ^ dat[i]];
   49   2          }
   50   1      
   51   1          if (has_crc)
   52   1          {
   53   2              return (crc == dat[size - 1]) ? 0 : crc;
   54   2          }
   55   1          else
   56   1          {
   57   2              return crc;
   58   2          }
