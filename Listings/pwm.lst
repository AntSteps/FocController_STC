  235          ////////////////////////////////////////
  236          // 异步方式读取PWMA特殊功能寄存器
  237          // 入口参数: addr: (PWMA特殊功能寄存器的低7位)
  238          // 函数返回: 寄存器的值
  239          ////////////////////////////////////////;
  240          uint8_t HSPWMA_ReadReg(uint8_t addr)
  241          {
  242   1          uint8_t dat;
  243   1      
  244   1          while (HSPWMA_CheckBusy());         //等待前一个异步读写完成
  245   1          HSPWMA_AsyncRead(addr, dat);        //触发异步方式读取寄存器
  246   1      
  247   1          return dat;
  248   1      }
