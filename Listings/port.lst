             -��模式
   36   1          SetP0nHighZInputMode(PIN_6 | PIN_5 | PIN_4); //设置P0.6,P0.5,P0.4为高阻输入模式
   37   1      
   38   1          DisableP0nPullUp(PIN_ALL);          //关闭P0内部上拉电阻
   39   1          DisableP0nPullDown(PIN_ALL);        //关闭P0内部下拉电阻
   40   1          DisableP0nSchmitt(PIN_ALL);         //使能P0施密特触发
   41   1          SetP0nSlewRateNormal(PIN_ALL);      //设置P0一般翻转速度
   42   1          SetP0nDrivingNormal(PIN_ALL);       //设置P0一般驱动能力
